# Compose / GCP deployment
APP_DOMAIN=reply.learngravity.com
OPENREPLY_IMAGE=us-west1-docker.pkg.dev/PROJECT_ID/openreply/openreply:sha-COMMIT
OPENREPLY_BACKUP_BUCKET=PROJECT_ID-openreply-backups

# Internal data services. Generate URL-safe values; the GCP setup script uses
# hex so the values can safely appear in connection URLs.
POSTGRES_PASSWORD=replace-with-random-hex
REDIS_PASSWORD=replace-with-random-hex

# Application
NEXTAUTH_URL=https://reply.learngravity.com
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=replace-with-64-hex-characters
ALLOWED_EMAILS=you@learngravity.com

# Email magic links
RESEND_API_KEY=re_replace-me
EMAIL_FROM=OpenReply <login@learngravity.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=replace-me
INSTAGRAM_APP_SECRET=replace-me
FACEBOOK_APP_SECRET=replace-me
WEBHOOK_VERIFY_TOKEN=replace-with-a-strong-random-secret

# Optional polling tuning
COMMENT_POLL_INTERVAL_MS=300000
COMMENT_POLL_MAX_PER_SWEEP=30
COMMENT_POLL_LOOKBACK_HOURS=72
